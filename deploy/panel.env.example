# /etc/l2xpanel/panel.env — created by install.sh.
# Do not put real passwords or SECRET_KEY into the repository.
# On first start the panel generates a random admin password (printed to the console
# and saved to $L2XPANEL_DATA/initial_credentials.txt) unless PANEL_ADMIN_PASSWORD is set.
# SECRET_KEY is generated automatically when missing (and stored under $L2XPANEL_DATA/secret_key).

APP_NAME="L2X Panel"

# Initial admin username (password is generated unless you set PANEL_ADMIN_PASSWORD in the real env file)
PANEL_ADMIN_USER=admin

# Public IP or domain used in subscription and share links (overridable in Settings → Panel)
L2XPANEL_PUBLIC_HOST=

# Paths
L2XPANEL_DATA=/var/lib/l2xpanel
XRAY_BIN=/usr/local/bin/xray
XRAY_CONFIG=/etc/xray/config.json
XRAY_LOCATION_ASSET=/usr/local/share/xray

# uvicorn bind address (nginx proxies :80 → 127.0.0.1:8090)
HOST=127.0.0.1
PORT=8090
