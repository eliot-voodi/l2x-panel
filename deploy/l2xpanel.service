[Unit]
Description=L2X Panel (slot live)
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/l2xpanel-live
EnvironmentFile=/etc/l2xpanel/panel.env
# acme.sh and other tools expect a real HOME
Environment=HOME=/root
# HOST/PORT come from panel.env (nginx: 127.0.0.1:8090, direct: 0.0.0.0:<public>)
ExecStart=/bin/sh -c 'exec /opt/l2xpanel-live/.venv/bin/uvicorn app:app --host "${HOST:-127.0.0.1}" --port "${PORT:-8090}" --proxy-headers --forwarded-allow-ips 127.0.0.1'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
