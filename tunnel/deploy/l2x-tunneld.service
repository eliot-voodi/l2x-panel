[Unit]
Description=L2X Tunnel Portal (tunneld)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStartPre=-/sbin/modprobe tcp_bbr
ExecStartPre=-/bin/bash -c 'command -v sysctl >/dev/null && sysctl -e -p /etc/sysctl.d/99-l2xpanel-perf.conf || true'
ExecStart=/usr/local/bin/l2x-tunneld -config /etc/l2x-tunnel/tunneld.yaml
Restart=always
RestartSec=2
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
